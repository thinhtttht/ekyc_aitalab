# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG HỆ THỐNG QAT eKYC (Sao chép thành .env khi triển khai)
# ==============================================================================

# 1. CẤU HÌNH BẢO MẬT & QUẢN TRỊ
# Bắt buộc API /api/users/enroll phải có session_id hợp lệ đã qua verify_final_capture (1 = Bật, 0 = Tắt)
EKYC_ENROLL_REQUIRE_SESSION=1

# Khóa API quản trị cho các thao tác nhạy cảm (xóa người dùng). Để trống trong môi trường Lab nội bộ.
EKYC_ADMIN_API_KEY=

# Khóa bí mật dùng để mã hóa ảnh chân dung sinh trắc học lưu trên đĩa
EKYC_DATA_KEY=qat-ekyc-biometric-secret-key-2026

# Giới hạn tần suất gọi API trên mỗi IP (số request / phút) và kích thước ảnh tối đa (bytes)
EKYC_RATE_LIMIT_PER_MIN=3600
EKYC_MAX_IMAGE_BYTES=10485760

# Danh sách Origin được phép gọi CORS (phân tách bằng dấu phẩy)
EKYC_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 2. CẤU HÌNH QUANG HỌC & NHẬN DIỆN SINH TRẮC HỌC
# Ngưỡng Cosine Similarity mặc định cho ArcFace 512D
EKYC_DEFAULT_VERIFY_THRESHOLD=0.55

# Ngưỡng tương quan Pearson cho bước nháy màu quang học (Color Flashing PAD)
EKYC_FLASH_MIN_PEARSON=0.02
EKYC_FLASH_MIN_AMPLITUDE=1.0
EKYC_FLASH_STEP_DURATION_MS=520

# Chế độ Demo Bypass cho nháy màu quang học (1 = Luôn cho qua khi demo webcam, 0 = Kiểm định nghiêm ngặt)
EKYC_FLASH_DEMO_BYPASS=1

# 3. CẤU HÌNH QUẢN LÝ PHIÊN & GỠ LỖI
EKYC_SESSION_TTL_SEC=600
EKYC_SESSION_CLEANUP_SEC=30
EKYC_MAX_ACTIVE_SESSIONS=50
EKYC_DEBUG=0
